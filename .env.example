# Base de donnees PostgreSQL
DATABASE_URL="postgresql://transitgo:transitgo@localhost:5432/transitgo?schema=public"
# Redis (verrous de sieges, files de reconciliation paiement)
REDIS_URL="redis://localhost:6379"
# Agregateur de paiement (a renseigner apres contractualisation)
PAYMENT_PROVIDER="sandbox"
PAYMENT_API_KEY=""
PAYMENT_API_SECRET=""
PAYMENT_WEBHOOK_SECRET=""
# Notifications — SMS (log | twilio | http) et WhatsApp (log | twilio | meta)
# Recommandé : twilio pour les deux (compte Atlastech existant, cf. Edufo)
SMS_PROVIDER=twilio
WA_PROVIDER=twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""      # ex. whatsapp:+14155238886 (sandbox) ou votre numéro approuvé
TWILIO_SMS_FROM=""           # numéro/alphanumérique SMS Twilio (facultatif si SMS non utilisé)
SMS_HTTP_URL=""
SMS_HTTP_KEY=""
SMS_SENDER=ReadyGo
WA_PHONE_ID=""
WA_TOKEN=""
WA_TEMPLATE_OTP=""
WA_TEMPLATE_TICKET=""
WA_LANG=fr
# Application
PORT=3000
JWT_SECRET="changez-moi"
SEAT_LOCK_TTL_SECONDS=600
# Abonnements — cycle de vie (jours)
SUB_GRACE_DAYS=7
SUB_REMINDER1_DAYS=7
SUB_REMINDER2_DAYS=2
SUB_SECOND_NOTICE_DAY=4
# Tâches planifiées internes (mettre false sur d'éventuels réplicas)
JOBS_ENABLED=true
# Origines autorisées (CORS) — séparées par des virgules
CORS_ORIGINS=https://readygo.atlastech.cm,http://localhost:3100
