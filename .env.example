# Base de donnees PostgreSQL
DATABASE_URL="postgresql://transitgo:transitgo@localhost:5432/transitgo?schema=public"
# Redis (verrous de sieges, files de reconciliation paiement)
REDIS_URL="redis://localhost:6379"
# Agregateur de paiement (a renseigner apres contractualisation)
PAYMENT_PROVIDER="sandbox"
PAYMENT_API_KEY=""
PAYMENT_API_SECRET=""
PAYMENT_WEBHOOK_SECRET=""
# SMS / OTP
SMS_GATEWAY_URL=""
SMS_GATEWAY_KEY=""
# Application
PORT=3000
JWT_SECRET="changez-moi"
SEAT_LOCK_TTL_SECONDS=600
# Abonnements — cycle de vie (jours)
SUB_GRACE_DAYS=7
SUB_REMINDER1_DAYS=7
SUB_REMINDER2_DAYS=2
SUB_SECOND_NOTICE_DAY=4
# Tâches planifiées internes (mettre false sur d'éventuels réplicas)
JOBS_ENABLED=true
